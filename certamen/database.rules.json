{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "identities": {
      "$klas": {
        ".read": "auth != null && (!root.child('klascodes/'+$klas+'/ownerUid').exists() || auth.uid === root.child('klascodes/'+$klas+'/ownerUid').val())",
        "$lid": {
          ".read": true,
          ".write": "!newData.child('admin').exists() || (data.child('admin').exists() && data.child('admin').val() === newData.child('admin').val())",
          ".validate": "newData.hasChildren(['name'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "coins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "xp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "level": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "battles": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "lastActive": { ".validate": "newData.isNumber()" },
          "pwHash": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "castra": { ".validate": "newData.isString() && newData.val().length <= 40000" },
          "apps": {
            "$appId": {
              ".validate": "newData.hasChildren(['score']) && newData.child('score').isNumber()",
              "score": { ".validate": "newData.isNumber()" },
              "detail": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "updatedAt": { ".validate": "newData.isNumber()" }
            }
          },
          "admin": {
            ".write": "auth != null",
            ".validate": "newData.isBoolean()"
          },
          "googleUid": {
            ".write": "auth != null && ((newData.exists() && auth.uid === newData.val() && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.exists() && data.val() === auth.uid))",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "googleEmail": {
            ".write": "auth != null && ((newData.exists() && root.child('identities/'+$klas+'/'+$lid+'/googleUid').val() === auth.uid) || (!newData.exists() && !root.child('identities/'+$klas+'/'+$lid+'/googleUid').exists()))",
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        }
      }
    },
    "studentSecrets": {
      "$klas": {
        ".read": "auth != null && root.child('klascodes/'+$klas+'/ownerUid').val() === auth.uid",
        "$lid": {
          ".read": "auth != null && root.child('googleLinks/'+auth.uid+'/klas').val() === $klas && root.child('googleLinks/'+auth.uid+'/lid').val() === $lid",
          ".write": true,
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 40"
        }
      }
    },
    "klascodes": {
      ".read": true,
      "$code": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('teacherStatus').child(auth.uid).child('status').val() === 'approved' || (!root.child('teacherStatus').child(auth.uid).exists() && root.child('teachers').child(auth.uid).exists())) && (!data.exists() || !data.child('ownerUid').exists() || auth.uid === data.child('ownerUid').val())",
        ".validate": "newData.hasChildren(['created','ownerUid']) && newData.child('created').isNumber()",
        "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "wordlists": {
          "$listId": {
            ".validate": "newData.hasChildren(['name','lang','words'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "lang": { ".validate": "newData.val() === 'la' || newData.val() === 'el'" }
          }
        }
      }
    },
    "teachers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).exists() || root.child('teacherStatus').child(auth.uid).child('status').val() === 'approved' || (!root.child('teacherStatus').child(auth.uid).exists() && data.exists()))",
        "wordlists": {
          "$listId": {
            ".validate": "newData.hasChildren(['name','lang','words'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "lang": { ".validate": "newData.val() === 'la' || newData.val() === 'el'" },
            "shared": { ".validate": "newData.isBoolean()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.isBoolean()"
      }
    },
    "teacherStatus": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['status','email','requestedAt'])",
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'revoked' || newData.val() === 'rejected'" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "requestedAt": { ".validate": "newData.isNumber()" }
      }
    },
    "klascodeMeta": {
      "$code": {
        ".read": true,
        "lastActive": { ".write": true, ".validate": "newData.isNumber()" }
      }
    },
    "googleLinks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['klas','lid'])",
        "klas": { ".validate": "newData.isString() && newData.val().length > 0" },
        "lid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "linkedAt": { ".validate": "newData.isNumber()" }
      }
    },
    "bossHof": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$entry": {
          ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).exists() || root.child('teacherStatus').child(auth.uid).child('status').val() === 'approved' || (!root.child('teacherStatus').child(auth.uid).exists() && root.child('teachers').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['bossId','diff','klas','ts','rounds'])",
          "bossId": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "diff": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "klas": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "ts": { ".validate": "newData.isNumber()" },
          "rounds": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "topNm": { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      }
    },
    "totalwar": {
      "showcaseUid": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.isString()"
      },
      "campaigns": {
        "$ownerUid": {
          ".read": true,
          ".write": "auth != null && auth.uid === $ownerUid && (root.child('admins').child(auth.uid).exists() || root.child('teacherStatus').child(auth.uid).child('status').val() === 'approved' || (!root.child('teacherStatus').child(auth.uid).exists() && root.child('teachers').child(auth.uid).exists()))",
          "provinces": {
            "$id": {
              ".write": true,
              ".validate": "newData.hasChildren(['owner','militiaPoints','wallPoints','towerPoints']) && newData.child('militiaPoints').isNumber() && newData.child('wallPoints').isNumber() && newData.child('towerPoints').isNumber()"
            }
          },
          "civs": {
            "$id": { ".write": true }
          },
          "klasSize": {
            "$klas": {
              ".read": true,
              "students": {
                "$lid": {
                  ".write": true,
                  ".validate": "newData.isBoolean()"
                }
              }
            }
          },
          "stats": {
            "topBuilder": {
              ".write": true,
              ".validate": "newData.hasChildren(['name','points']) && newData.child('points').isNumber()"
            }
          }
        }
      }
    },
    "usedKlascodes": {
      ".read": "auth != null",
      "_seeded": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "$klas": { ".write": true, ".validate": "newData.isNumber() && newData.val() >= 0" }
    },
    "classAnalytics": {
      "$klas": {
        ".read": true,
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$wordkey": {
            ".write": true,
            ".validate": "newData.hasChildren(['p','c']) && newData.child('c').isNumber() && newData.child('c').val() >= 0",
            "p": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "a": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },
    "config": {
      "skillTrees": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['enabled']) && newData.child('enabled').isBoolean()"
      }
    },
    "castraLegio": {
      "$klas": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('klascodes/'+$klas+'/ownerUid').val() === auth.uid)",
        "event": {
          ".validate": "newData.hasChildren(['id','mission','seed','status']) && (newData.child('status').val() === 'lobby' || newData.child('status').val() === 'running')",
          "id": { ".validate": "newData.isNumber()" },
          "mission": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "seed": { ".validate": "newData.isNumber()" },
          "startAt": { ".validate": "newData.isNumber()" },
          "players": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" }
        },
        "players": {
          "$lid": {
            ".write": true,
            ".validate": "newData.hasChildren(['nm','ts'])",
            "nm": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ts": { ".validate": "newData.isNumber()" }
          }
        },
        "actions": {
          "$aid": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['t','k','x','y','lid','st'])",
            "t": { ".validate": "newData.isNumber()" },
            "k": { ".validate": "newData.val() === 'place'" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 64" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 64" },
            "lid": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "sid": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "line": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "hid": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "st": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "nm": { ".validate": "newData.isString() && newData.val().length <= 30" }
          }
        }
      }
    },
    "castraColosseum": {
      "$klas": {
        ".read": true,
        ".indexOn": ["status", "createdAt"],
        "$match": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['mode','fee','divisie','seed','need','status','createdBy','createdAt']) && (data.exists() || (!newData.hasChild('runs') && !newData.hasChild('paid') && !newData.hasChild('live') && !newData.hasChild('startAt')))",
          "mode": { ".validate": "newData.val() === 'duel' || newData.val() === 'quad'" },
          "fee": { ".validate": "newData.val() === 100" },
          "divisie": { ".validate": "newData.val() === 20 || newData.val() === 35 || newData.val() === 50" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "need": { ".validate": "(newData.parent().child('mode').val() === 'duel' && newData.val() === 2) || (newData.parent().child('mode').val() === 'quad' && newData.val() === 4)" },
          "ghosts": {
            ".write": "root.child('castraColosseum/'+$klas+'/'+$match+'/status').val() === 'lobby' && !data.exists()",
            ".validate": "newData.parent().child('mode').val() === 'quad' && ((newData.val() === 1 && !newData.parent().child('slots').hasChild('s3')) || (newData.val() === 2 && !newData.parent().child('slots').hasChild('s2') && !newData.parent().child('slots').hasChild('s3')))"
          },
          "createdBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 60000" },
          "status": {
            ".write": "data.val() === 'lobby'",
            ".validate": "newData.val() === 'lobby' || (data.val() === 'lobby' && newData.val() === 'running' && newData.parent().child('startAt').exists() && (newData.parent().child('mode').val() === 'duel' ? newData.parent().child('slots').hasChildren(['s0','s1']) : (newData.parent().child('ghosts').val() === 1 ? newData.parent().child('slots').hasChildren(['s0','s1','s2']) : (newData.parent().child('ghosts').val() === 2 ? newData.parent().child('slots').hasChildren(['s0','s1']) : newData.parent().child('slots').hasChildren(['s0','s1','s2','s3'])))))"
          },
          "startAt": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.parent().child('status').val() === 'running' && newData.val() >= now - 5000 && newData.val() <= now + 120000"
          },
          "slots": {
            "$s": {
              ".write": "root.child('castraColosseum/'+$klas+'/'+$match+'/status').val() === 'lobby' && (!data.exists() || !newData.exists())",
              ".validate": "($s === 's0' || $s === 's1' || (newData.parent().parent().child('mode').val() === 'quad' && ($s === 's2' || $s === 's3'))) && (!newData.parent().parent().child('ghosts').exists() || (newData.parent().parent().child('ghosts').val() === 1 && $s !== 's3') || (newData.parent().parent().child('ghosts').val() === 2 && ($s === 's0' || $s === 's1'))) && newData.isString() && newData.val().length <= 40"
            }
          },
          "players": {
            "$lid": {
              ".write": "root.child('castraColosseum/'+$klas+'/'+$match+'/status').val() === 'lobby'",
              ".validate": "newData.hasChildren(['nm','ts']) && $lid.length <= 40 && (newData.parent().parent().child('slots').child('s0').val() === $lid || newData.parent().parent().child('slots').child('s1').val() === $lid || newData.parent().parent().child('slots').child('s2').val() === $lid || newData.parent().parent().child('slots').child('s3').val() === $lid)",
              "nm": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "ts": { ".validate": "newData.isNumber()" }
            }
          },
          "live": {
            "$lid": {
              ".write": "root.child('castraColosseum/'+$klas+'/'+$match+'/status').val() === 'running' && root.child('castraColosseum/'+$klas+'/'+$match+'/players/'+$lid).exists()",
              ".validate": "newData.hasChildren(['wave','lives','ts'])",
              "wave": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
              "lives": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "ts": { ".validate": "newData.isNumber()" }
            }
          },
          "runs": {
            "$lid": {
              ".write": "!data.exists() && root.child('castraColosseum/'+$klas+'/'+$match+'/status').val() === 'running' && root.child('castraColosseum/'+$klas+'/'+$match+'/players/'+$lid).exists() && now <= root.child('castraColosseum/'+$klas+'/'+$match+'/startAt').val() + 2200000",
              ".validate": "newData.hasChildren(['actions','res','ts'])",
              "actions": { ".validate": "newData.isString() && newData.val().length <= 30000" },
              "res": {
                ".validate": "newData.hasChildren(['tick','wave','lives','kills'])",
                "tick": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40000" },
                "wave": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
                "lives": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "kills": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
                "win": { ".validate": "newData.val() === 0 || newData.val() === 1" },
                "quit": { ".validate": "newData.val() === 0 || newData.val() === 1" },
                "$other": { ".validate": false }
              },
              "ts": { ".validate": "newData.isNumber() && newData.val() >= root.child('castraColosseum/'+$klas+'/'+$match+'/startAt').val() && newData.val() <= now + 10000" },
              "$other": { ".validate": false }
            }
          },
          "paid": {
            "$lid": {
              ".write": "!data.exists() && root.child('castraColosseum/'+$klas+'/'+$match+'/players/'+$lid).exists()",
              ".validate": "newData.val() === true"
            }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "castraTrades": {
      "$klas": {
        ".read": true,
        "$tid": {
          ".write": true,
          ".validate": "newData.hasChildren(['from','fn','give','status','ts'])",
          "from": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "fn": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "give": { ".validate": "newData.isString() && newData.val().length <= 1500" },
          "status": { ".validate": "newData.val() === 'open' || newData.val() === 'done'" },
          "ts": { ".validate": "newData.isNumber()" },
          "to": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "tn": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "get": { ".validate": "newData.isString() && newData.val().length <= 1500" }
        }
      }
    },
    "classAnalyticsCastra": {
      "$klas": {
        ".read": true,
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$key": {
            ".write": true,
            ".validate": "newData.hasChildren(['p','k','c'])",
            "p": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "k": { ".validate": "newData.val() === 'w' || newData.val() === 's'" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },
    "classAnalyticsCastraTD": {
      "$klas": {
        ".read": true,
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$key": {
            ".write": true,
            "$field": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },
    "classAnalyticsChronica": {
      "$klas": {
        ".read": true,
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "$key": {
            ".write": true,
            ".validate": "newData.hasChild('p')",
            "p": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "a": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "c": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "goed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "fout": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    }
  }
}
